{
  "name": "terntech-payments-api",
  "private": true,
  "version": "1.0.0",
  "description": "JazzCash and Easypaisa mobile-wallet payments for terntechshop.com",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
