# ---------------------------------------------------------------------------
# Tern Technologies payment server — environment variables
#
# On Hostinger, enter these in the web app's "Environment variables" panel.
# Never commit real values: this file is a template only.
# ---------------------------------------------------------------------------

# Firebase service account (Firebase Console -> Project settings -> Service
# accounts -> Generate new private key). Paste the JSON, or its Base64 encoding.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=terntechshop

# Websites allowed to call this API (comma-separated, no trailing slash).
ALLOWED_ORIGINS=https://terntechshop.com,https://www.terntechshop.com

# --- JazzCash (Merchant Portal -> Integration) -------------------------------
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# Live by default. Sandbox: https://sandbox.jazzcash.com.pk
JAZZCASH_BASE_URL=https://payments.jazzcash.com.pk

# --- Easypaisa (credentials issued by the Easypaisa merchant team) -----------
EASYPAISA_STORE_ID=
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=
# Your merchant Easypaisa account number (used to check payment status).
EASYPAISA_ACCOUNT_NUMBER=
# Live by default. Staging: https://easypaystg.easypaisa.com.pk
EASYPAISA_BASE_URL=https://easypay.easypaisa.com.pk

# --- Behaviour (optional; defaults shown) ------------------------------------
# PAYMENT_WINDOW_MINUTES=30
# GATEWAY_TIMEOUT_SECONDS=90
# REVIEW_AFTER_MINUTES=20
# MAX_ATTEMPTS_PER_ORDER=5
# RATE_LIMIT_PER_USER=10
# RATE_LIMIT_PER_IP=30
