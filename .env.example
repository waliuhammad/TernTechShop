# ---------------------------------------------------------------------------
# Firebase web configuration
#
# Copy this file to `.env` and paste the values from:
#   Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup
#
# These values are PUBLIC. Every Firebase web app ships them in its JavaScript
# bundle — they identify your project, they do not grant access. Access control
# is enforced by firestore.rules on Google's servers.
#
# A private key (service account JSON) must NEVER appear in this file or any
# VITE_ variable: anything prefixed VITE_ is compiled into the browser bundle.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 to point the app at the local Firebase Emulator Suite
# (`npm run emulators`) instead of your live project. Development only.
VITE_USE_FIREBASE_EMULATOR=0

# ---------------------------------------------------------------------------
# Cloudinary — product image uploads from the admin panel (free plan)
#
# Setup: docs/CLOUDINARY-SETUP.md. Both values are public (they end up in the
# site's JavaScript). NEVER put the Cloudinary API secret here.
# ---------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=fvpzi9pm
VITE_CLOUDINARY_UPLOAD_PRESET=terntech_products
